	quest_links: [ ]
	quests: [
		{
			description: [
				"Ars Nouveau can be played as a spellcasting mod, but in CABIN it is most useful when treated as another automation layer."
				""
				"This page follows the usual Ars progression first, then branches into the addons installed here: Ars Elemental, Ars Technica, Ars Creo, and Ars Energistique."
				""
				"You do not need to complete every branch immediately. Build the source network first, then pick the automation tools that solve a real factory problem."
			]
			icon: "ars_nouveau:novice_spell_book"
			id: "0F8DEC23AAC72D5D"
			shape: "hexagon"
			size: 2.0d
			tasks: [{
				id: "2CDBF23511816875"
				type: "checkmark"
			}]
			title: "Arcane Engineering"
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"The Worn Notebook is the in-game manual. Keep it nearby; Ars has many small rules around Source, pedestals, rituals, and summons."
				""
				"If a recipe on this page feels underspecified, check its Notebook entry and JEI page before changing your build."
			]
			icon: "ars_nouveau:worn_notebook"
			id: "5EB6946060E985F3"
			tasks: [{
				id: "769FB369A142E913"
				item: "ars_nouveau:worn_notebook"
				type: "item"
			}]
			title: "Read the Notebook"
			x: -2.0d
			y: 2.0d
		}
		{
			description: [
				"Archwood is the first material bottleneck. Trees spawn in the world, and an Archwood Forest biome is the most comfortable place to stock up."
				""
				"Bring saplings home once you find them. Later rituals and source loops both appreciate a renewable Archwood supply."
			]
			icon: "ars_nouveau:green_archwood_log"
			id: "62AED3239518CCAD"
			tasks: [{
				icon: "ars_nouveau:green_archwood_log"
				id: "2F550266D7F4D4DE"
				item: {
					Count: 1
					id: "itemfilters:or"
					tag: {
						items: [
							{
								Count: 1b
								id: "ars_nouveau:blue_archwood_log"
							}
							{
								Count: 1b
								id: "ars_nouveau:green_archwood_log"
							}
							{
								Count: 1b
								id: "ars_nouveau:purple_archwood_log"
							}
							{
								Count: 1b
								id: "ars_nouveau:red_archwood_log"
							}
						]
					}
				}
				title: "Any Archwood Log"
				type: "item"
			}]
			title: "Archwood Samples"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["62AED3239518CCAD"]
			description: [
				"The Novice Spell Book is your first caster. Start with practical spells: Projectile + Break, Touch + Light, Self + Leap, and Touch + Interact."
				""
				"These are not just combat toys. Early Ars spells are excellent utility tools while your Create factory is still small."
			]
			icon: "ars_nouveau:novice_spell_book"
			id: "58FBE1D126FA33E2"
			shape: "square"
			tasks: [{
				id: "097220262DD9DD94"
				item: "ars_nouveau:novice_spell_book"
				type: "item"
			}]
			title: "First Spell Book"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["58FBE1D126FA33E2"]
			description: [
				"Use the Scribe's Table to add glyphs to your spell book and to inscribe spell parchment for turrets, Reactive gear, and other automation."
				""
				"Treat this as your spell workbench. Put it somewhere you can reach often."
			]
			icon: "ars_nouveau:scribes_table"
			id: "5A7717EA328C04BA"
			tasks: [{
				id: "188A0DC690CFF859"
				item: "ars_nouveau:scribes_table"
				type: "item"
			}]
			title: "Scribe's Table"
			x: 2.0d
			y: 6.0d
		}
		{
			description: [
				"Unlock a few workhorse glyphs before chasing damage. Break handles mining, Light handles building, and Craft is surprisingly useful once inventories start to pile up."
				""
				"Good early spell examples: Projectile + Break, Touch + Light, Self + Launch + Slowfall, and Touch + Craft."
			]
			icon: "ars_nouveau:glyph_break"
			id: "70A5A2E11D182F13"
			tasks: [
				{
					id: "456692B7605EE8DE"
					item: "ars_nouveau:glyph_break"
					type: "item"
				}
				{
					id: "1B938056892CEC0A"
					item: "ars_nouveau:glyph_light"
					type: "item"
				}
				{
					id: "1B8462D87B4ED881"
					item: "ars_nouveau:glyph_craft"
					type: "item"
				}
			]
			title: "Practical Glyphs"
			x: 0.0d
			y: 8.0d
		}
		{
			dependencies: ["70A5A2E11D182F13"]
			description: [
				"The Imbuement Chamber starts the material side of Ars. Its most important early job is turning amethyst or lapis into Source Gems."
				""
				"Place Source Jars nearby later to speed recipes that need Source."
			]
			icon: "ars_nouveau:imbuement_chamber"
			id: "7BE53A3DD7B8DAB6"
			tasks: [{
				id: "6FF70305D540BDAF"
				item: "ars_nouveau:imbuement_chamber"
				type: "item"
			}]
			title: "Imbuement Chamber"
			x: -2.0d
			y: 10.0d
		}
		{
			dependencies: ["7BE53A3DD7B8DAB6"]
			description: [
				"Source Gems are the basic circuit boards of Ars Nouveau. Make a batch before moving on; almost every machine, glyph, and addon recipe asks for them."
				""
				"A small amethyst or lapis supply is enough to get started."
			]
			icon: "ars_nouveau:source_gem"
			id: "0CA0FED52D7186F5"
			tasks: [{
				count: 8L
				id: "7E79ABE1ABFEA3B7"
				item: "ars_nouveau:source_gem"
				type: "item"
			}]
			title: "Gem Reserve"
			x: 0.0d
			y: 10.0d
		}
		{
			description: [
				"Source Jars are the batteries for Ars. Most machines and rituals do not consume FE; they look for Source in nearby jars."
				""
				"Keep at least one jar by the Imbuement Chamber and another near your Enchanting Apparatus once that is built."
			]
			icon: "ars_nouveau:source_jar"
			id: "4257F0D6D8DA7619"
			tasks: [{
				id: "0F1F95462675DDF9"
				item: "ars_nouveau:source_jar"
				type: "item"
			}]
			title: "Source Storage"
			x: 2.0d
			y: 10.0d
		}
		{
			dependencies: ["4257F0D6D8DA7619"]
			description: [
				"Sourcelinks generate Source. Pick one that matches an existing resource loop instead of building a new one from scratch."
				""
				"Volcanic likes burnable fuel, Agronomic likes crop and tree growth, Mycelial likes food, Vitalic likes breeding and mob deaths, and Alchemical likes potions."
			]
			icon: "ars_nouveau:agronomic_sourcelink"
			id: "1C54D7689D3CE63E"
