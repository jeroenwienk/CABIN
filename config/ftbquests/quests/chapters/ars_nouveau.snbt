				type: "item"
			}]
			title: "Mage's Spell Book"
			x: 0.0d
			y: 16.0d
		}
		{
			dependencies: ["1B2B6AC133C8B030"]
			description: [
				"Spell Parchments let machines cast for you. A Basic Spell Turret can place, break, harvest, ignite, or trigger effects depending on the spell you inscribe."
				""
				"Ars Creo also lets turrets and Source Jars behave on Create contraptions, which turns spells into mobile factory tools."
			]
			icon: "ars_nouveau:basic_spell_turret"
			id: "1B4FD91CE73F6667"
			tasks: [
				{
					id: "5F6937D69F6C62F6"
					item: "ars_nouveau:spell_parchment"
					type: "item"
				}
				{
					id: "1CE141D62666EF33"
					item: "ars_nouveau:basic_spell_turret"
					type: "item"
				}
			]
			title: "Spells as Machines"
			x: 2.0d
			y: 16.0d
		}
		{
			description: [
				"Rituals are area machines. Some run once, while others keep working as long as they can pull Source from nearby jars."
				""
				"Harvest and Overgrowth are the obvious factory starters. Sanctuary, Warping, Containment, Scrying, and Flight are worth reading about before you need them."
			]
			icon: "ars_nouveau:ritual_brazier"
			id: "61F9609F1746781F"
			tasks: [
				{
					id: "06F2C063B0303AB0"
					item: "ars_nouveau:ritual_brazier"
					type: "item"
				}
				{
					id: "40FA178102D1783B"
