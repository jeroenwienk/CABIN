			}]
			title: "Whirlisprig Garden"
			x: -2.0d
			y: 20.0d
		}
		{
			description: [
				"Wixies can craft items and brew potions using nearby inventories, Potion Jars, and Source."
				""
				"Start simple: bind a few ingredient chests, set one recipe on the cauldron, and add redstone control before expanding."
			]
			icon: "ars_nouveau:wixie_charm"
			id: "600DFBAA36454F6E"
