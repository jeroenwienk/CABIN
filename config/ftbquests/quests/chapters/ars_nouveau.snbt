					item: "ars_nouveau:arcane_pedestal"
					type: "item"
				}
			]
			title: "Apparatus Crafting"
			x: 0.0d
			y: 14.0d
		}
		{
			description: [
				"Magebloom Seeds come from the Enchanting Apparatus and unlock Magebloom Fiber."
				""
				"Automate this like any other crop once possible. Fiber becomes armor, thread, book upgrades, and a lot of utility recipes."
			]
			icon: "ars_nouveau:magebloom"
			id: "5D13F9B87BD4D6A3"
			tasks: [
				{
					id: "50006719E5D4054B"
