				}
				{
					id: "377906A873137036"
					item: "ars_nouveau:magebloom_fiber"
					type: "item"
				}
			]
			title: "Magebloom Crop"
			x: -2.0d
			y: 16.0d
		}
		{
			description: [
				"The Apprentice Spell Book opens the middle of Ars. This is where spells become strong enough to replace several hand tools and small machines."
				""
				"Useful mid-tier goals: Extract, Place Block, Harvest, Grow, Exchange, Fortune, and Ender Inventory."
			]
			icon: "ars_nouveau:apprentice_spell_book"
			id: "1B2B6AC133C8B030"
			tasks: [{
				id: "296C8014F6C45F81"
