		{
			description: [
				"The Dominion Wand configures Source Relays, Starbuncles, Whirlisprigs, Wixies, and several other Ars blocks."
				""
				"Use the wand on the source first, then on the destination. Sneak-use to clear or switch strict-side behavior."
			]
			icon: "ars_nouveau:dominion_wand"
			id: "5B9988ECF28CD3F4"
			tasks: [
				{
					id: "7EC8D97149817D1E"
