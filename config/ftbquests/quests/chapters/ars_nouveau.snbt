			}]
			title: "Starbuncle Logistics"
			x: -4.0d
			y: 20.0d
		}
		{
			description: [
				"Whirlisprigs generate natural drops from the area around their home. Their output depends on nearby block variety and Source supply."
				""
				"Use them for renewable oddities: flowers, saplings, crops, and other nature materials that are annoying to belt-farm directly."
			]
			icon: "ars_nouveau:whirlisprig_charm"
			id: "52BC52EE665D0D50"
			tasks: [{
				id: "70AC2F98663C3165"
