			x: 2.0d
			y: 26.0d
		}
		{
			dependencies: ["1B2B6AC133C8B030"]
			description: [
				"The Archmage Spell Book and Wilden progression are the late-game spell goals. Prepare strong armor, good mobility, and enough Source before summoning the Wilden Chimera."
				""
				"Ars Elemental's Mark of Mastery is a good parallel endpoint for a spell-focused character."
			]
			icon: "ars_nouveau:archmage_spell_book"
			id: "126F34CA0FAD8835"
			tasks: [
