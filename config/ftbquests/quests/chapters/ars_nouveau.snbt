					type: "item"
				}
			]
			title: "Route the Flow"
			x: 2.0d
			y: 12.0d
		}
		{
			description: [
				"The Enchanting Apparatus is the main progression gate. It crafts spell book upgrades, Magebloom Seeds, charms, curios, and several addon machines."
				""
				"Build it with an Arcane Core underneath and up to eight Arcane Pedestals within three blocks."
			]
			icon: "ars_nouveau:enchanting_apparatus"
			id: "4A30969D066DB85C"
			shape: "hexagon"
			size: 2.0d
			tasks: [
