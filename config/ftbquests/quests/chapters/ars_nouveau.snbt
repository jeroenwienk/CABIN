					type: "item"
				}
			]
			title: "Ritual Worksite"
			x: 0.0d
			y: 18.0d
		}
		{
			description: [
				"Starbuncles are tiny item logistics workers. Use the Dominion Wand to bind inventories and item movement paths."
				""
				"They are not a replacement for belts everywhere, but they are excellent around compact Ars setups, potion rooms, and awkward machine corners."
			]
			icon: "ars_nouveau:starbuncle_charm"
			id: "38EBF22EE4FAF8F1"
			tasks: [{
				id: "3B236B1C6BCC594A"
