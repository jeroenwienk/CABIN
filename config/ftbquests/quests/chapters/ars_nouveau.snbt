		{
			description: [
				"Ars Technica ties Source into Create. The Calibrated Precision Mechanism is made in the Enchanting Apparatus from a Precision Mechanism, amethyst, Source Gems, and Source."
				""
				"Once you craft the Source Motor, you can turn Source into rotational force. This is the cleanest direct bridge between magic infrastructure and Create stress."
			]
			icon: "ars_technica:source_engine"
			id: "4A5D5DFA8021A999"
